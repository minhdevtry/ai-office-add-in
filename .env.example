# Cấu hình Server AI Word Add-in
PORT=3001
HOST=127.0.0.1
USE_HTTPS=false

# Cấu hình AI API Endpoint
# Mặc định hỗ trợ cả OpenAI-compatible (DeepSeek, OpenAI, Gemini, v.v.) và Anthropic-compatible
AI_API_ENDPOINT=https://api.deepseek.com/chat/completions
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-chat

# Cấu hình Thinking Mode
AI_ENABLE_THINKING=true
