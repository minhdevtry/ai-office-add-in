# ═══════════════════════════════════════════════════════════════════
# AI WORD ADD-IN & MCP AGENT BRIDGE — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy file này thành `.env` và điền các giá trị thật.
# KHÔNG commit `.env` lên git (đã có trong .gitignore).

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
# Bật HTTPS (Office Add-in yêu cầu HTTPS cho manifest URLs)
# false: dev nhanh với http; true: cần chạy `npm run certs` trước
USE_HTTPS=false
# Thư mục chứa cert self-signed (output của office-addin-dev-certs)
OFFICE_ADDIN_CERT_DIR=

# ─── AI Provider (server-side, client KHÔNG override được) ────────────────
# Default trỏ về 2tocom.space gateway + MiniMax-M3 model
# Endpoint PHẢI có full path (vd: /v1/chat/completions cho OpenAI-compatible)
AI_API_ENDPOINT=https://aiapi.2tocom.space/v1/chat/completions
AI_API_KEY=keykeykeykeykeykeykeykey
AI_MODEL=MiniMax-M3

# Thinking effort mặc định: off | low | medium | high | xhigh
# (client có thể chỉnh qua dropdown trên UI, nhưng default là giá trị này)
AI_DEFAULT_EFFORT=medium
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ─── Supabase (License DB) ────────────────────────────────────────────────
# Tạo project tại https://supabase.com, lấy URL + service_role key từ Settings → API
# LƯU Ý: dùng service_role key (không phải anon) — key này có toàn quyền.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── License Control ───────────────────────────────────────────────────────
# false: bỏ qua license check (dev); true: bắt buộc phải activate
LICENSE_REQUIRED=false
# TTL cache license ở client (giây)
LICENSE_HEARTBEAT_TTL=3600
# Rate limit cho /api/license/activate (per IP per minute)
LICENSE_ACTIVATE_RATE_PER_MIN=5

# ─── CORS Whitelist ───────────────────────────────────────────────────────
# Comma-separated. Wildcard * chỉ hỗ trợ ở một segment (vd: https://*.officeapps.live.com)
CORS_ORIGINS=https://localhost:3001,http://localhost:3001,https://*.officeapps.live.com
