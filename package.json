{
  "name": "ai-add-in-word",
  "version": "1.0.0",
  "description": "AI-powered Microsoft Word Add-in & MCP Agent Bridge",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "mcp": "node server/mcp-server.js",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install --days 365"
